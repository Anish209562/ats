{
  "name": "ats/legacy-app",
  "description": "Legacy PHP applicant tracking system.",
  "type": "project",
  "require": {
    "php": ">=8.1",
    "smalot/pdfparser": "^2.11"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5",
    "squizlabs/php_codesniffer": "^4.0",
    "phpstan/phpstan": "^2.1"
  },
  "scripts": {
    "lint": "phpcs --standard=phpcs.xml --extensions=php api cpanel data index.php popup.php sms.php",
    "typecheck": "phpstan analyse --no-progress --memory-limit=512M",
    "test": "node --test tests/contracts/*.test.js",
    "audit": "composer audit"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {}
  }
}
